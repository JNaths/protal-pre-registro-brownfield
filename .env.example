# Template only — copy to .env.local and adjust for your local setup.
# Never commit real credentials or a populated .env / .env.local file.

# Matches the docker-compose.yml "postgres" service defined in this repo.
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_preregistro?schema=public

PORT=3000

# Phase 4: secret used to sign the express-session cookie ID (D-01/D-02).
# Set to a long random string in any real environment; a dev-only insecure
# fallback is used automatically if this is unset locally.
SESSION_SECRET=

# Phase 4 (D-11): reception staff account provisioned by prisma/seed.ts.
# Never hardcode credentials — set these before running `npm run db:seed`.
RECEPTION_EMAIL=
RECEPTION_PASSWORD=
